# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The "service_role" secret key. Server-only: never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
# Where this site lives, without a trailing slash (used to build private links)
SITE_URL=https://ghss-vellalankulam.vercel.app
# Link people share to invite others (can stay the TinyURL)
SHARE_URL=https://tinyurl.com/GHSS-Vellalankulam-Alumni

# --- Admin ---
# Long random string. Used for the CSV export: /api/admin/export?key=...
ADMIN_KEY=
# Vercel sets this automatically for cron calls if you add it in Vercel settings (optional)
CRON_SECRET=

# --- Optional: "lost my link" emails via Gmail (free, ~500/day) ---
# Needs 2-step verification on the Gmail account + an App Password
GMAIL_USER=
GMAIL_APP_PASSWORD=
